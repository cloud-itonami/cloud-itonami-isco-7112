;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a job-site scheduling/logistics coordination robot
;; performs crew scheduling, materials-usage/progress-record logging and
;; masonry-materials supply-order coordination for bricklayers (ISCO 7112). It
;; never lays bricks or decides masonry work. Its physical work is materials
;; logistics: moving brick/block pallets from the delivery point to the
;; bricklayers' station, and handing a block up to the scaffold board.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-7112"
 :cases
 [{:id :brick-pallet-to-station
   :kind :transport
   :procedure "logistics robot moves a brick/block pallet 40 m over a compacted site from the delivery point to the bricklayers' station"
   :params {:mass-kg 300.0 :distance-m 40.0 :v-max-mps 0.6 :a-max-mps2 0.2
            :brake-decel-mps2 0.4 :drive-force-n 1000.0 :crr 0.05
            :cog-height-m 0.55 :support-half-length-m 0.55}
   :sweep {:param :payload-kg :values [200.0 400.0 700.0 1000.0 1300.0]}
   :quantity :cycle-time-s
   :limit {:max 150.0 :basis "estimate: a pallet must reach the station within ~2.5 minutes so the crew's mortar board does not go off"}
   :boundary {:lo 50.0 :hi 2000.0}}
  {:id :block-to-scaffold-board
   :kind :manipulator
   :procedure "arm hands a brick or concrete block from the pallet up to the scaffold board at the working course"
   :params {:l1-m 0.70 :l2-m 0.60 :m1-kg 10.0 :m2-kg 7.0
            :from [0.75 0.20] :to [0.35 1.10] :duration-s 2.5 :steps 500}
   :sweep {:param :payload-kg :values [2.5 5.0 10.0 15.0 20.0]}
   :quantity :peak-tau1-nm
   :limit {:max 200.0 :basis "estimate: continuous shoulder torque of a ~20 kg payload class arm"}
   :boundary {:lo 0.5 :hi 50.0}}]}
